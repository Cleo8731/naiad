flowchart TD
    collect[Collect data] --> clean{Clean?}
    clean -- yes --> train[Train model]
    clean -- no --> fix[Fix the data]
    fix --> clean

    subgraph review [Review]
        train --> evaluate([Evaluate])
        evaluate --> ship((Ship))
    end

    style ship fill:#d3f9d8,stroke:#2f9e44,color:#1c2026

